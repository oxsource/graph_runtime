package(default_visibility = ["//visibility:public"])

cc_library(
    name = "types",
    hdrs = ["types.h"],
    deps = [
        "@com_google_absl//absl/status",
    ],
)

cc_library(
    name = "log_interface",
    srcs = ["logger.cc"],
    hdrs = ["logger.h"],
    copts = [
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
    ],
    deps = [
        "@com_google_absl//absl/synchronization",
    ],
)

cc_library(
    name = "side_packet",
    hdrs = ["side_packet.h"],
    deps = [
        "@graph_runtime//src/stream:packet",
        "@graph_runtime//src/public:types",
    ],
)

cc_library(
    name = "graph_builder",
    srcs = ["graph_builder.cc"],
    hdrs = ["graph_builder.h"],
    deps = [
        ":runtime_internal",
        "@graph_runtime//src/config:config",
        "@graph_runtime//src/config:graph_config",
        "@graph_runtime//src/scheduler:scheduler",
        "@graph_runtime//src/scheduler:thread_pool_executor",
        "@graph_runtime//src/node:node_factory_registry",
    ],
)

cc_library(
    name = "runtime_internal",
    hdrs = [
        "graph_runtime.h",
        "types.h",
        "side_packet.h",
    ],
    copts = [
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
    ],
    deps = [
        ":log_interface",
        "@graph_runtime//src/config:graph_config",
        "@graph_runtime//src/scheduler:scheduler",
        "@graph_runtime//src/node:graph_context",
        "@graph_runtime//src/public:types",
        "@graph_runtime//src/stream:packet",
    ],
)

cc_library(
    name = "runtime",
    srcs = [
        "graph_runtime.cc",
        "graph_runtime_init.cc",
    ],
    hdrs = [
        "include/graph_runtime/graph_runtime.h",
        "include/graph_runtime/graph_runtime_export.h",
        "include/graph_runtime/types.h",
        "include/graph_runtime/timestamp.h",
        "include/graph_runtime/packet.h",
        "include/graph_runtime/graph_config.h",
        "include/graph_runtime/side_packet.h",
        "include/graph_runtime/logger.h",
    ],
    strip_include_prefix = "include",
    copts = [
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
    ],
    alwayslink = 1,
    deps = [
        ":graph_builder",
        ":log_interface",
        ":runtime_internal",
        "@graph_runtime//src/scheduler:scheduler",
        "@graph_runtime//src/config:graph_config",
        "@graph_runtime//src/public:types",
    ],
)

cc_binary(
    name = "runtime_shared",
    linkshared = True,
    linkstatic = True,
    copts = [
        "-DGRAPH_RUNTIME_SHARED_LIBRARY",
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
    ],
    deps = [
        ":runtime",
    ],
)
