package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "executor",
    hdrs = ["executor.h"],
    deps = [
        "@com_google_absl//absl/status:statusor",
    ],
)

cc_library(
    name = "input_stream_handler",
    srcs = ["input_stream_handler.cc"],
    hdrs = ["input_stream_handler.h"],
    deps = [
        ":executor",
        "@graph_runtime//src/stream:input_stream_manager",
        "@graph_runtime//src/node:node_base",
        "@graph_runtime//src/node:graph_context",
        "@graph_runtime//src/public:types",
    ],
)

cc_library(
    name = "thread_pool_executor",
    srcs = ["thread_pool_executor.cc"],
    hdrs = ["thread_pool_executor.h"],
    deps = [
        ":executor",
    ],
)

cc_library(
    name = "scheduler_queue",
    srcs = ["scheduler_queue.cc"],
    hdrs = ["scheduler_queue.h"],
    deps = [
        ":executor",
        "@graph_runtime//src/node:node_base",
    ],
)

cc_library(
    name = "scheduler",
    srcs = ["scheduler.cc"],
    hdrs = ["scheduler.h"],
    deps = [
        ":executor",
        ":scheduler_queue",
        ":thread_pool_executor",
        ":input_stream_handler",
        "@graph_runtime//src/log:log_core",
        "@graph_runtime//src/stream:input_stream_manager",
        "@graph_runtime//src/stream:input_stream",
        "@graph_runtime//src/stream:output_stream_handler",
        "@graph_runtime//src/node:graph_context",
        "@graph_runtime//src/node:node_factory_registry",
        "@graph_runtime//src/node:node_base",
    ],
)
