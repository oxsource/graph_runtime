package(default_visibility = ["//src/framework:__subpackages__", "//src/tests:__subpackages__", "//src/examples:__subpackages__"])

# @nlohmann_json dependency is intentionally restricted to this package.
# No module outside //src/config/json may depend on nlohmann/json.
# The IGraphConfigParser interface in //src/config:config fully
# abstracts format details from the rest of the runtime.

cc_library(
    name = "json_parser",
    srcs = ["json_parser.cc"],
    hdrs = ["json_parser.h"],
    deps = [
        "@graph_runtime//src/framework/config:config",
        "@nlohmann_json//:json",
    ],
)

filegroup(
    name = "testdata",
    srcs = glob(["testdata/*.json"]),
    visibility = ["@graph_runtime//src/tests:__pkg__"],
)
