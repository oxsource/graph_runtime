package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hook_header",
    hdrs = [
        "include/graph_runtime/hook.h",
        "include/graph_runtime/graph_runtime_export.h",
    ],
    strip_include_prefix = "include",
)

cc_library(
    name = "profiler_header",
    hdrs = ["include/graph_runtime/profiler.h"],
    strip_include_prefix = "include",
    deps = [
        ":hook_header",
    ],
)

cc_library(
    name = "types",
    hdrs = ["types.h"],
    deps = [
        "@com_google_absl//absl/status",
    ],
)

cc_library(
    name = "side_packet",
    hdrs = ["side_packet.h"],
    deps = [
        "@graph_runtime//src/framework/stream:packet",
        "@graph_runtime//src/framework/public:types",
    ],
)

cc_library(
    name = "graph_builder",
    srcs = ["graph_builder.cc"],
    hdrs = ["graph_builder.h"],
    visibility = ["//src/framework:__subpackages__", "//src/tests:__subpackages__"],
    deps = [
        ":runtime_internal",
        "@graph_runtime//src/framework/config:config",
        "@graph_runtime//src/framework/config:graph_config",
        "@graph_runtime//src/framework/scheduler:scheduler",
        "@graph_runtime//src/framework/scheduler:thread_pool_executor",
        "@graph_runtime//src/framework/node:node_factory_registry",
    ],
)

cc_library(
    name = "runtime_internal",
    hdrs = [
        "graph_runtime.h",
        "types.h",
        "side_packet.h",
    ],
    visibility = ["//src/framework:__subpackages__", "//src/tests:__subpackages__"],
    deps = [
        ":hook_header",
        "@graph_runtime//src/framework/config:graph_config",
        "@graph_runtime//src/framework/scheduler:scheduler",
        "@graph_runtime//src/framework/node:graph_context",
        "@graph_runtime//src/framework/public:types",
        "@graph_runtime//src/framework/stream:packet",
    ],
)

cc_library(
    name = "runtime",
    srcs = [
        "graph_runtime.cc",
        "graph_runtime_init.cc",
    ],
    hdrs = [
        "include/graph_runtime/graph_runtime.h",
        "include/graph_runtime/graph_runtime_export.h",
        "include/graph_runtime/types.h",
        "include/graph_runtime/timestamp.h",
        "include/graph_runtime/packet.h",
        "include/graph_runtime/graph_config.h",
        "include/graph_runtime/side_packet.h",
        "include/graph_runtime/logger.h",
        "include/graph_runtime/hook.h",
        "include/graph_runtime/profiler.h",
    ],
    strip_include_prefix = "include",
    alwayslink = 1,
    deps = [
        ":graph_builder",
        ":runtime_internal",
        ":profiler_header",
        "@graph_runtime//src/framework/utils:logger",
        "@graph_runtime//src/framework/scheduler:scheduler",
        "@graph_runtime//src/framework/config:graph_config",
        "@graph_runtime//src/framework/public:types",
    ],
)

cc_binary(
    name = "runtime_shared",
    linkshared = True,
    linkstatic = True,
    copts = [
        "-DGRAPH_RUNTIME_SHARED_LIBRARY",
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
    ],
    deps = [
        ":runtime",
    ],
)
