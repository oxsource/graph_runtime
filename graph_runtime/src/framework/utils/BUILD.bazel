package(default_visibility = ["//src/framework:__subpackages__", "//src/tests:__subpackages__"])

cc_library(
    name = "hook",
    srcs = ["hook.cc"],
    hdrs = ["hook.h"],
    deps = ["@graph_runtime//src/framework/public:hook_header"],
)

cc_library(
    name = "logger",
    srcs = ["logger.cc"],
    hdrs = ["logger.h"],
    # NOTE: do not compile with -fvisibility=hidden here. libscheduler (and
    # other internal dylibs) cross-call graph::runtime::Logger::Info/Error
    # etc. Those symbols must stay exported, otherwise the lazy binding in the
    # calling dylib resolves to NULL and crashes at runtime (GOT=0 -> pc=0).
    deps = [
        "@graph_runtime//src/framework/utils:hook",
        "@com_google_absl//absl/synchronization",
    ],
)
