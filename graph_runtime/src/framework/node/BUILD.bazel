package(default_visibility = ["//src/framework:__subpackages__", "//src/tests:__subpackages__"])

cc_library(
    name = "node_options",
    srcs = ["node_options.cc"],
    hdrs = ["node_options.h"],
)

cc_library(
    name = "options_registry",
    srcs = ["options_registry.cc"],
    hdrs = ["options_registry.h"],
    deps = [
        ":node_options",
    ],
)

cc_library(
    name = "node_contract",
    hdrs = ["node_contract.h"],
    deps = [
        "@graph_runtime//src/framework/stream:packet",
        "@graph_runtime//src/framework/public:types",
    ],
)

cc_library(
    name = "node_base",
    srcs = ["node.cc"],
    hdrs = ["node.h"],
    deps = [
        ":node_contract",
        ":node_options",
        "@graph_runtime//src/framework/stream:input_stream_manager",
        "@graph_runtime//src/framework/stream:output_stream",
    ],
)

cc_library(
    name = "node_factory",
    srcs = ["node_factory.cc"],
    hdrs = ["node_factory.h"],
    deps = [
        ":node_base",
        ":node_contract",
    ],
)

cc_library(
    name = "node_factory_registry",
    srcs = ["node_registry.cc"],
    hdrs = ["node_registry.h"],
    deps = [
        ":node_factory",
    ],
)

cc_library(
    name = "graph_context",
    srcs = ["graph_context.cc"],
    hdrs = ["graph_context.h"],
    deps = [
        ":node_base",
        ":node_options",
        "@graph_runtime//src/framework/stream:input_stream",
        "@graph_runtime//src/framework/stream:output_stream_shard",
        "@graph_runtime//src/framework/public:side_packet",
        "@graph_runtime//src/framework/stream:packet",
        "@graph_runtime//src/framework/public:types",
    ],
)
